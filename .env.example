# Copy to .env for local runs. The demo needs NOTHING here: it runs keyless on built-in sample data.
# Streamlit Community Cloud ignores .env; put these in the app's Secrets instead (see .streamlit/secrets.toml.example).

# --- Database (SQLite file; delete it to reset the demo to its seed data) ---
POC_DB=l3.db

# --- Optional: natural-language answers instead of quoting the matching doc text ---
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- Optional: real systems (code is wired; each switches on when its keys exist) ---
# SN_INSTANCE=            # + SN_USER, SN_PASSWORD   -> create real ServiceNow incidents
# CONFLUENCE_URL=         # + CONFLUENCE_USER, CONFLUENCE_TOKEN, CONFLUENCE_SPACE -> crawl Confluence
# AZURE_SEARCH_ENDPOINT=  # + AZURE_SEARCH_KEY       -> Azure AI Search
# CONTENT_SAFETY_ENDPOINT=  # + CONTENT_SAFETY_KEY   -> Azure Prompt Shields
# AAD_TENANT_ID=          # + AAD_CLIENT_ID          -> Entra token validation on the REST API
