# Streamlit Community Cloud -> app Settings -> Secrets. Every key is optional; with none set the demo runs fully on built-in sample data.
# OPENAI_API_KEY = "sk-..."      # plain OpenAI key (simplest); optional OPENAI_MODEL = "gpt-4o-mini"
# or Azure OpenAI:
# AZURE_OPENAI_ENDPOINT = "https://<resource>.openai.azure.com"
# AZURE_OPENAI_API_KEY = "<key>"
# AZURE_OPENAI_DEPLOYMENT = "<chat deployment name>"
